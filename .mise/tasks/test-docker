#!/usr/bin/env bash
#MISE description="Run the Docker-in-Docker integration suite (real Podman/systemd/WireGuard against a privileged container standing in for a remote host)"
set -e

compose_file="test/docker/compose.yml"

cleanup() {
    docker compose -f "$compose_file" down -t 0 -v
}
trap cleanup EXIT

docker compose -f "$compose_file" up -d --build --wait

# Each docker_*_test.rs file under crates/jiji-cli/tests/ is its own test binary; list new ones
# here as the suite grows.
docker_tests=(docker_server_lifecycle_test docker_deploy_test docker_build_deploy_test docker_rolling_deploy_test)

if command -v cargo-nextest >/dev/null 2>&1; then
    JIJI_DOCKER_TESTS=1 cargo nextest run -p jiji-cli "${docker_tests[@]/#/--test=}" --no-capture
else
    for test in "${docker_tests[@]}"; do
        JIJI_DOCKER_TESTS=1 cargo test -p jiji-cli --test "$test" -- --nocapture
    done
fi
