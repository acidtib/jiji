{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "plugins": ["cargo-workspace"],
  "packages": {
    "crates/jiji-cli": {
      "release-type": "rust",
      "package-name": "jiji",
      "component": "jiji",
      "include-component-in-tag": false
    },
    "crates/jiji-agent": {
      "release-type": "rust",
      "package-name": "jiji-agent",
      "component": "jiji-agent",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "crates/jiji-proxy": {
      "release-type": "rust",
      "package-name": "jiji-proxy",
      "component": "jiji-proxy",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "crates/jiji-core": {
      "release-type": "rust",
      "package-name": "jiji-core",
      "component": "jiji-core",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "crates/jiji-tui": {
      "release-type": "rust",
      "package-name": "jiji-tui",
      "component": "jiji-tui",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "crates/jiji-config": {
      "release-type": "rust",
      "package-name": "jiji-config",
      "component": "jiji-config",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "crates/jiji-network": {
      "release-type": "rust",
      "package-name": "jiji-network",
      "component": "jiji-network",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "crates/jiji-ssh": {
      "release-type": "rust",
      "package-name": "jiji-ssh",
      "component": "jiji-ssh",
      "include-component-in-tag": true,
      "tag-separator": "-"
    }
  }
}
