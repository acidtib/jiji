#!/bin/bash

# Setup script for jiji project

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

info()  { echo -e "${GREEN}==>${NC} $1"; }
warn()  { echo -e "${YELLOW}==>${NC} $1"; }
error() { echo -e "${RED}==>${NC} $1" >&2; }

REQUIRED_CARGO_MAJOR=1

# Check for cargo
if ! command -v cargo &> /dev/null; then
  error "cargo is not installed."
  echo "  Install it from https://rustup.rs or via mise:"
  echo "    mise install rust"
  exit 1
fi

# Check cargo version
CARGO_VERSION=$(cargo --version | head -1 | sed 's/cargo //' | cut -d' ' -f1)
CARGO_MAJOR=$(echo "$CARGO_VERSION" | cut -d. -f1)

if [ "$CARGO_MAJOR" -lt "$REQUIRED_CARGO_MAJOR" ]; then
  error "cargo $REQUIRED_CARGO_MAJOR.x+ is required (found $CARGO_VERSION)."
  echo "  Update with: rustup update or mise install rust"
  exit 1
fi

info "cargo $CARGO_VERSION"

# Check for mise (optional but recommended)
if command -v mise &> /dev/null; then
  MISE_VERSION=$(mise --version | cut -d' ' -f1)
  info "mise $MISE_VERSION"
else
  warn "mise is not installed (optional, needed for build/version tasks)."
  echo "  Install it from https://mise.jdx.dev"
fi

# Fetch cargo dependencies
info "Fetching cargo dependencies..."
cargo fetch

info "Setup complete!"
